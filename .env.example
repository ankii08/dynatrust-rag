# DynaTrust-RAG Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --- API Keys ---
# At least one embedding/LLM provider key is required unless using "local" mode.
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# --- Database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=atlas4d

# --- Embedding provider: "gemini", "openai", or "local" ---
DYNATRUST_EMBEDDING_PROVIDER=local

# --- LLM provider: "gemini", "openai", or "local" ---
# "local" returns deterministic summaries without calling an external API.
DYNATRUST_LLM_PROVIDER=local
